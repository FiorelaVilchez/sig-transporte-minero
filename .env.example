# Variables de entorno — SIG Transporte Minero
# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el .env real al repositorio.

# ─────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────
SECRET_KEY=cambiar-por-una-clave-secreta-segura-en-produccion
DEBUG=True

# ─────────────────────────────────────────
# Base de datos (RNF-04: SQLite ↔ PostgreSQL)
# ─────────────────────────────────────────
# Opción 1 — SQLite (por defecto, no requiere configuración extra):
#   Deja DB_ENGINE comentado o elimina las líneas de DB_*
#   El sistema usará automáticamente db.sqlite3 en la raíz del proyecto.

# Opción 2 — PostgreSQL (versión final del proyecto):
#   Descomenta y rellena las líneas siguientes con tus credenciales reales.
DB_ENGINE=postgresql
DB_NAME=sig_transporte_minero
DB_USER=postgres
DB_PASSWORD=tu_contrasena_de_postgres
# Use 127.0.0.1 y no localhost: en Windows, localhost puede demorar cada conexión.
DB_HOST=127.0.0.1
DB_PORT=5432

# Segundos que se reutiliza la conexión a PostgreSQL (0 = abrir una por petición).
DB_CONN_MAX_AGE=60

# Nombre de la empresa que se muestra en el encabezado.
EMPRESA_NOMBRE=Transportes Kallpa Andina S.A.C.

# Dominios permitidos cuando DEBUG=False, separados por comas (en local puede quedar vacío).
# ALLOWED_HOSTS=midominio.pe,www.midominio.pe
# Conexión en una sola línea (Render la llena sola); si existe, reemplaza a DB_*.
# DATABASE_URL=postgres://usuario:clave@host:5432/base
