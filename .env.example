# Variables de entorno — SIG Transporte Minero
# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el .env real al repositorio.

# ─────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────
SECRET_KEY=cambiar-por-una-clave-secreta-segura-en-produccion
DEBUG=True

# ─────────────────────────────────────────
# Base de datos (RNF-04: SQLite ↔ PostgreSQL)
# ─────────────────────────────────────────
# Opción 1 — SQLite (por defecto, no requiere configuración extra):
#   Deja DB_ENGINE comentado o elimina las líneas de DB_*
#   El sistema usará automáticamente db.sqlite3 en la raíz del proyecto.

# Opción 2 — PostgreSQL (versión final del proyecto):
#   Descomenta y rellena las líneas siguientes con tus credenciales reales.
DB_ENGINE=postgresql
DB_NAME=sig_transporte_minero
DB_USER=postgres
DB_PASSWORD=9538216
DB_HOST=localhost
DB_PORT=5432